{
  "trainer": {
    "gpus": 1,
    "num_workers": 1,
    "precision": "bf16-mixed",
    "strategy": "auto",
    "epochs": 5,
    "seed": 0,
    "val_check_interval": 0.5,
    "log_interval": 10,
    "save_dir": "${work}/outputs/save_CFF/tests/flex_attention",
    "wandb_entity": "rquiles",
    "wandb": "tests",
    "compile": false,
    "ckpt_every_n_steps": 50,
    "save_every": true
  },
  "data": {
    "train_path": "/cluster/work/boeva/rquiles/data/eheiss_RAW/pipeline_ready",
    "conditions": ["tissue_general"],
    "zero_percentages": [0.2, 0.4, 0.6],
    "bulk_ratio": 0.45,
    "pb_ratio": 0.45,
    "precomputed_pb": true,
    "pb_group_column": "tissue_general",
    "trunc_by_sample": true,
    "balanced_sampler": false,
    "balanced_labels": ["tissue_general"]
  },
  "model": {
    "nlayers": 8,
    "nheads": 8,
    "embsize": 256,
    "d_hid": 1024,
    "attn_impl": "flex",
    "grad_checkpoint": "true",
    "monitor_losses": ["mmd"],
    "lr": 0.0001,
    "warmup_ratio_or_step": 10000,
    "max_seq_len": 1200,
    "batch_size": 256,
    "input_style": "binned",
    "input_data": "counts",
    "loss": "mse",
    "training_tasks": "both",
    "do_mvc": true,
    "where_condition": "none",
    "gen_method": "theirs"
  },
  "features": {
    "verbose": true,
    "unified": true,
    "mmd": false,
    "cdd": false,
    "cdd_class_aware": false,
    "cdd_cluster_warmup_steps": 0,
    "loss_weight_mmd": 1000,
    "loss_weight_cdd": 1000
  }
}

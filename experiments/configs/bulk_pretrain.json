{
  "launch_name": "bulk_pretrain",
  "experiments_root": "/cluster/work/boeva/rquiles/unifiedFM_experiments",
  "dry_run": false,
  "train_entrypoint": "pretrain:main",
  "base_config": {
    "trainer": {
      "gpus": 1,
      "num_workers": 4,
      "precision": "bf16-mixed",
      "strategy": "auto",
      "epochs": 5,
      "seed": 0,
      "val_check_interval": 0.5,
      "log_interval": 50,
      "wandb_entity": "rquiles",
      "wandb": "unifiedFM",
      "compile": true,
      "ckpt_every_n_steps": 10000
    },
    "data": {
      "train_path": {"pipeline_ready": "bulk:leiden_s0"},
      "zero_percentages": [0.2, 0.4, 0.6]
    },
    "model": {
      "nlayers": 8,
      "nheads": 8,
      "embsize": 256,
      "d_hid": 1024,
      "lr": 0.0001,
      "warmup_ratio_or_step": 1000,
      "max_seq_len": 1200,
      "batch_size": 64,
      "input_style": "binned",
      "loss": "mse",
      "training_tasks": "both",
      "do_mvc": true,
      "where_condition": "none",
      "gen_method": "theirs"
    },
    "features": {}
  },
  "base_overrides": {},
  "models": [
    {
      "name": "bulk_only",
      "overrides": {
        "data": {
          "train_path": {"pipeline_ready": "bulk:leiden_s0"}
        }
      }
    }
  ],
  "downstream_tasks": [],
  "slurm": {
    "enabled": true,
    "python_executable": "python",
    "sbatch_args": [
      "--time=72:00:00",
      "--partition=gpu",
      "--ntasks-per-node=1",
      "--gres=gpu:rtx4090:1",
      "--cpus-per-task=4",
      "--mem-per-cpu=16G"
    ],
    "environment": {},
    "job_name_prefix": "ufm",
    "project_root": "/cluster/work/boeva/rquiles/CancerFoundationFusion",
    "singularity_image": "/cluster/customapps/biomed/boeva/rquiles/bionemo-framework_v1.sif",
    "binds": [
      "/cluster/work/boeva/rquiles",
      "/cluster/work/boeva/eheiss",
      "/cluster/work/boeva/bulkFM"
    ]
  }
}

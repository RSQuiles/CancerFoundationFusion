{
  "experiment_name": "paired_alignment_objectives",
  "output_dir": "ablation_runs/paired_alignment_objectives",
  "dry_run": false,
  "train_entrypoint": "pretrain:main",

  "_about": [
    "Six arms: two single-modality baselines, then the unified model with a",
    "distribution-alignment objective (MMD or CDD), with and without aggregation",
    "consistency. Everything but the objective is held fixed, so a difference between",
    "arms is attributable to the objective and not to capacity or schedule.",
    "",
    "  1 bulk_baseline    non-unified, bulk-only store",
    "  2 sc_baseline      non-unified, SC-only store",
    "  3 paired_mmd       unified + paired sampling + MMD",
    "  4 paired_cdd       unified + paired sampling + CDD",
    "  5 paired_mmd_agg   3 + aggregation consistency",
    "  6 paired_cdd_agg   4 + aggregation consistency"
  ],

  "_data_requirements": [
    "The store at data.train_path must carry, in obs.parquet:",
    "  * modality      -- bulk / sc / pseudobulk rows (always required)",
    "  * paired        -- shared pair id on a pseudobulk row AND its bulk row, 0 =",
    "                     unpaired. Required by paired_sampling; BulkSCSampler raises",
    "                     at startup if no id is shared between the two modalities, so",
    "                     a store without it fails loudly rather than training wrong.",
    "  * pseudobulk_id -- shared id on a pseudobulk row AND the single cells it was",
    "                     aggregated from. Required by arms 5/6 only. Written by",
    "                     data_preprocess/reconstruct_pseudobulk_cell_map.py --rebuild",
    "                     and carried through bulk_sc_data_preprocessing.py with",
    "                     --pb-id-column pseudobulk_id (it is dropped otherwise).",
    "Arms 5/6 abort at startup with a message naming the column if it is missing."
  ],

  "base_config": {
    "trainer": {
      "gpus": 1,
      "num_workers": 4,
      "precision": "bf16-mixed",
      "strategy": "auto",
      "epochs": 100,
      "seed": 0,
      "val_check_interval": 0.5,
      "log_interval": 5,
      "save_dir": "${work}/outputs/save_CFF/ablation_paired_alignment_objectives",
      "wandb_entity": "rquiles",
      "wandb": "ablation_paired_alignment_objectives",
      "compile": true,
      "ckpt_every_n_steps": 1000,
      "save_every": false,
      "resume_from_checkpoint": "last"
    },
    "data": {
      "train_path": "/cluster/work/boeva/rquiles/data/eheiss_RAW_paired/pipeline_ready",
      "conditions": ["modality", "tissue_general"],
      "zero_percentages": [0.2, 0.4, 0.6],
      "bulk_ratio": 0.45,
      "pb_ratio": 0.45,
      "n_sc_per_pseudobulk": 5,
      "precomputed_pb": true,
      "pb_id_column": "pseudobulk_id",
      "pb_group_column": "tissue_general",
      "trunc_by_sample": true,
      "balanced_sampler": true,
      "balanced_labels": ["tissue_general"]
    },
    "model": {
      "nlayers": 8,
      "nheads": 8,
      "embsize": 256,
      "d_hid": 1024,
      "attn_impl": "flex",
      "grad_checkpoint": "true",
      "lr": 0.0001,
      "warmup_ratio_or_step": 10000,
      "max_seq_len": 1200,
      "batch_size": 128,
      "input_style": "binned",
      "input_data": "counts",
      "loss": "mse",
      "training_tasks": "both",
      "do_mvc": true,
      "where_condition": "none",
      "gen_method": "theirs"
    },
    "features": {
      "loss_weight_paired": 10,
      "loss_weight_mmd": 1000,
      "loss_weight_cdd": 1000,
      "loss_weight_agg": 1,
      "loss_weight_reconstruction": 1
    }
  },

  "base_overrides": {},

  "ablations": [
    {
      "name": "paired_cdd",
      "_note": "Class-conditional alignment: CDD matches per-tissue conditionals, so the sampler draws class-aware batches with shared tissues in both halves.",
      "overrides": {
        "trainer": {
          "save_dir": "${work}/outputs/save_CFF/ablation_paired_alignment_objectives/paired_cdd",
          "wandb_name": "paired_cdd"
        },
        "data": {},
        "model": { "monitor_losses": ["mmd", "aggregation"] },
        "features": {
          "unified": true,
          "paired_sampling": true,
          "cdd": true,
          "cdd_class_aware": true,
          "cdd_cluster_warmup_steps": 0
        }
      }
    },
    {
      "name": "paired_cdd_agg",
      "_note": "paired_cdd plus aggregation consistency; the 2x2 completion of arms 3-5.",
      "overrides": {
        "trainer": {
          "save_dir": "${work}/outputs/save_CFF/ablation_paired_alignment_objectives/paired_cdd_agg",
          "wandb_name": "paired_cdd_agg"
        },
        "data": {},
        "model": { "monitor_losses": ["mmd"] },
        "features": {
          "unified": true,
          "paired_sampling": true,
          "cdd": true,
          "cdd_class_aware": true,
          "cdd_cluster_warmup_steps": 0,
          "agg_consistency": true,
          "agg_fn": "mean"
        }
      }
    }
  ],

  "downstream_tasks": [],

  "slurm": {
    "enabled": true,
    "python_executable": "python",
    "sbatch_args": [
      "--time=48:00:00",
      "--partition=gpu",
      "--ntasks-per-node=1",
      "--gres=gpu:rtx4090:1",
      "--cpus-per-task=4",
      "--mem-per-cpu=32G"
    ],
    "environment": {},
    "job_name_prefix": "ab_align"
  }
}
{
  "experiment_name": "monitor_align",
  "output_dir": "ablation_runs/monitor_align",
  "dry_run": false,
  "train_entrypoint": "pretrain:main",
  "base_config": {
    "trainer": {
      "gpus": 1,
      "num_workers": 4,
      "precision": "bf16-mixed",
      "strategy": "auto",
      "epochs": 100,
      "seed": 0,
      "val_check_interval": 0.5,
      "log_interval": 5,
      "save_dir": "${work}/outputs/save_CFF/ablation_monitor_align",
      "wandb_entity": "rquiles",
      "wandb": "ablation_monitor_align",
      "compile": true,
      "ckpt_every_n_steps": 100,
      "save_every": false,
      "resume_from_checkpoint": "last"
    },
    "data": {
      "train_path": "/cluster/work/boeva/rquiles/data/mini_eheiss_RAW/pipeline_ready",
      "conditions": ["tissue_general", "modality"],
      "zero_percentages": [0.2, 0.4, 0.6],
      "bulk_ratio": 0.45,
      "pb_ratio": 0.45,
      "precomputed_pb": true,
      "pb_group_column": "tissue_general",
      "trunc_by_sample": true,
      "balanced_sampler": false,
      "balanced_labels": ["tissue_general"]
    },
    "model": {
      "nlayers": 8,
      "nheads": 8,
      "embsize": 256,
      "d_hid": 512,
      "attn_impl": "flex",
      "grad_checkpoint": "true",
      "monitor_losses": ["mmd", "cdd"],
      "lr": 0.0001,
      "warmup_ratio_or_step": 10000,
      "max_seq_len": 1200,
      "batch_size": 256,
      "input_style": "binned",
      "input_data": "counts",
      "loss": "mse",
      "training_tasks": "both",
      "do_mvc": true,
      "where_condition": "none",
      "gen_method": "theirs"
    },
    "features": {
      "unified": true,
      "loss_weight_paired": 10,
      "loss_weight_dat": 10,
      "loss_weight_mmd": 1000,
      "loss_weight_cdd": 1000,
      "loss_weight_agg": 1,
      "loss_weight_reconstruction": 1
    }
  },
  "base_overrides": {},
  "ablations": [
    {
      "name": "unified",
      "overrides": {
        "trainer": {
          "save_dir": "${work}/outputs/save_CFF/ablation_monitor_align/unified",
          "wandb_name": "unified"
        },
        "data": {},
        "model": {},
        "features": {
          "unified": true
        }
      }
    },
    {
      "name": "condition",
      "overrides": {
        "trainer": {
          "save_dir": "${work}/outputs/save_CFF/ablation_monitor_align/condition",
          "wandb_name": "condition"
        },
        "data": {
          "conditions": ["modality"]
        },
        "model": {
          "where_condition": "end"
        },
        "features": {
          "unified": true
        }
      }
    },
    {
      "name": "mmd",
      "overrides": {
        "trainer": {
          "save_dir": "${work}/outputs/save_CFF/ablation_monitor_align/mmd",
          "wandb_name": "mmd"
        },
        "data": {},
        "model": {},
        "features": {
          "unified": true,
          "mmd": true
        }
      }
    },
    {
      "name": "dat",
      "overrides": {
        "trainer": {
          "save_dir": "${work}/outputs/save_CFF/ablation_monitor_align/dat",
          "wandb_name": "dat"
        },
        "data": {},
        "model": {},
        "features": {
          "unified": true,
          "do_dat": true,
          "dat_columns": ["modality"],
          "dat_interval_steps": 3
        }
      }
    },
    {
      "name": "cdd",
      "overrides": {
        "trainer": {
          "save_dir": "${work}/outputs/save_CFF/ablation_monitor_align/cdd",
          "wandb_name": "cdd"
        },
        "data": {},
        "model": {},
        "features": {
          "unified": true,
          "cdd": true,
          "cdd_class_aware": true,
          "cdd_cluster_warmup_steps": 50
        }
      }
    }
  ],
  "downstream_tasks": [],
  "slurm": {
    "enabled": true,
    "python_executable": "python",
    "sbatch_args": [
      "--time=2:00:00",
      "--partition=gpu",
      "--ntasks-per-node=1",
      "--gres=gpu:rtx4090:1",
      "--cpus-per-task=4",
      "--mem-per-cpu=16G"
    ],
    "environment": {},
    "job_name_prefix": "ab_united"
  }
}
{
  "experiment_name": "paired_alignment_objectives",
  "output_dir": "ablation_runs/paired_alignment_objectives",
  "dry_run": false,
  "train_entrypoint": "pretrain:main",

  "_about": [
    "Six arms: two single-modality baselines, then the unified model with a",
    "distribution-alignment objective (MMD or CDD), with and without aggregation",
    "consistency. Everything but the objective is held fixed, so a difference between",
    "arms is attributable to the objective and not to capacity or schedule.",
    "",
    "  1 bulk_baseline    non-unified, bulk-only store",
    "  2 sc_baseline      non-unified, SC-only store",
    "  3 paired_mmd       unified + paired sampling + MMD",
    "  4 paired_cdd       unified + paired sampling + CDD",
    "  5 paired_mmd_agg   3 + aggregation consistency",
    "  6 paired_cdd_agg   4 + aggregation consistency"
  ],

  "_data_requirements": [
    "The store at data.train_path must carry, in obs.parquet:",
    "  * modality      -- bulk / sc / pseudobulk rows (always required)",
    "  * paired        -- shared pair id on a pseudobulk row AND its bulk row, 0 =",
    "                     unpaired. Required by paired_sampling; BulkSCSampler raises",
    "                     at startup if no id is shared between the two modalities, so",
    "                     a store without it fails loudly rather than training wrong.",
    "  * pseudobulk_id -- shared id on a pseudobulk row AND the single cells it was",
    "                     aggregated from. Required by arms 5/6 only. Written by",
    "                     data_preprocess/reconstruct_pseudobulk_cell_map.py --rebuild",
    "                     and carried through bulk_sc_data_preprocessing.py with",
    "                     --pb-id-column pseudobulk_id (it is dropped otherwise).",
    "Arms 5/6 abort at startup with a message naming the column if it is missing."
  ],

  "_batch_arithmetic": [
    "batch_size 64 with bulk_ratio = pb_ratio = 0.45 gives n_bulk = n_pb = 29,",
    "n_sc = 6. paired_sampling requires n_bulk == n_pb, hence the equal ratios.",
    "Rows actually embedded per step, by batch kind:",
    "  standard, arms 3/4 : n_bulk + n_sc + n_pb                    =  64",
    "  standard, arms 5/6 : n_bulk + n_sc + n_pb * (1 + 5)          = 209",
    "  paired  (all arms) : n_bulk + n_pb * (1 + n_sc_per_pseudobulk) = 203",
    "n_sc_per_pseudobulk is 5 rather than the default 10 to keep arms 5/6 at ~209",
    "rows, comparable to monitor_align's 256 at the same max_seq_len. Raising it",
    "multiplies the arm-5/6 step cost directly. The three lengths must stay distinct:",
    "BulkSCCollator infers the batch kind from len(examples) and raises on a collision."
  ],

  "base_config": {
    "trainer": {
      "gpus": 1,
      "num_workers": 4,
      "precision": "bf16-mixed",
      "strategy": "auto",
      "epochs": 100,
      "seed": 0,
      "val_check_interval": 0.5,
      "log_interval": 5,
      "save_dir": "${work}/outputs/save_CFF/ablation_paired_alignment_objectives",
      "wandb_entity": "rquiles",
      "wandb": "ablation_paired_alignment_objectives",
      "compile": true,
      "ckpt_every_n_steps": 100,
      "save_every": false,
      "resume_from_checkpoint": "last"
    },
    "data": {
      "train_path": "/cluster/work/boeva/rquiles/data/eheiss_RAW_paired/pipeline_ready",
      "conditions": ["tissue_general", "modality"],
      "zero_percentages": [0.2, 0.4, 0.6],
      "bulk_ratio": 0.45,
      "pb_ratio": 0.45,
      "n_sc_per_pseudobulk": 5,
      "precomputed_pb": true,
      "pb_id_column": "pseudobulk_id",
      "pb_group_column": "tissue_general",
      "trunc_by_sample": true,
      "balanced_sampler": false,
      "balanced_labels": ["tissue_general"]
    },
    "model": {
      "nlayers": 8,
      "nheads": 8,
      "embsize": 256,
      "d_hid": 512,
      "attn_impl": "flex",
      "grad_checkpoint": "true",
      "lr": 0.0001,
      "warmup_ratio_or_step": 10000,
      "max_seq_len": 1200,
      "batch_size": 64,
      "input_style": "binned",
      "input_data": "counts",
      "loss": "mse",
      "training_tasks": "both",
      "do_mvc": true,
      "where_condition": "none",
      "gen_method": "theirs"
    },
    "features": {
      "loss_weight_paired": 10,
      "loss_weight_mmd": 1000,
      "loss_weight_cdd": 1000,
      "loss_weight_agg": 1,
      "loss_weight_reconstruction": 1
    }
  },

  "base_overrides": {},

  "ablations": [
    {
      "name": "bulk_baseline",
      "_note": "Single-modality reference. Non-unified, so no alignment objective and no pseudobulk machinery: the plain SingleCellDataset/AnnDataCollator path.",
      "overrides": {
        "trainer": {
          "save_dir": "${work}/outputs/save_CFF/ablation_paired_alignment_objectives/bulk_baseline",
          "wandb_name": "bulk_baseline"
        },
        "data": {
          "train_path": "/cluster/work/boeva/rquiles/data/bulk_counts/pipeline_ready",
          "conditions": ["tissue_general"],
          "precomputed_pb": false,
          "pb_id_column": null
        },
        "model": {},
        "features": {}
      }
    },
    {
      "name": "sc_baseline",
      "_note": "The SC counterpart of bulk_baseline. Confirm this store exists and holds SC rows only; no config in the repo referenced it before.",
      "overrides": {
        "trainer": {
          "save_dir": "${work}/outputs/save_CFF/ablation_paired_alignment_objectives/sc_baseline",
          "wandb_name": "sc_baseline"
        },
        "data": {
          "train_path": "/cluster/work/boeva/rquiles/data/sc_counts/pipeline_ready",
          "conditions": ["tissue_general"],
          "precomputed_pb": false,
          "pb_id_column": null
        },
        "model": {},
        "features": {}
      }
    },
    {
      "name": "paired_mmd",
      "_note": "Marginal alignment: MMD pulls the bulk and pseudobulk embedding distributions together without using class labels.",
      "overrides": {
        "trainer": {
          "save_dir": "${work}/outputs/save_CFF/ablation_paired_alignment_objectives/paired_mmd",
          "wandb_name": "paired_mmd"
        },
        "data": {},
        "model": { "monitor_losses": ["cdd", "aggregation"] },
        "features": {
          "unified": true,
          "paired_sampling": true,
          "mmd": true
        }
      }
    },
    {
      "name": "paired_cdd",
      "_note": "Class-conditional alignment: CDD matches per-tissue conditionals, so the sampler draws class-aware batches with shared tissues in both halves.",
      "overrides": {
        "trainer": {
          "save_dir": "${work}/outputs/save_CFF/ablation_paired_alignment_objectives/paired_cdd",
          "wandb_name": "paired_cdd"
        },
        "data": {},
        "model": { "monitor_losses": ["mmd", "aggregation"] },
        "features": {
          "unified": true,
          "paired_sampling": true,
          "cdd": true,
          "cdd_class_aware": true,
          "cdd_cluster_warmup_steps": 50
        }
      }
    },
    {
      "name": "paired_mmd_agg",
      "_note": "paired_mmd plus aggregation consistency. agg_fn is mean: a sum over the 5 sampled cells would scale with the sample size, not with the pseudobulk they are matched to.",
      "overrides": {
        "trainer": {
          "save_dir": "${work}/outputs/save_CFF/ablation_paired_alignment_objectives/paired_mmd_agg",
          "wandb_name": "paired_mmd_agg"
        },
        "data": {},
        "model": { "monitor_losses": ["cdd"] },
        "features": {
          "unified": true,
          "paired_sampling": true,
          "mmd": true,
          "agg_consistency": true,
          "agg_fn": "mean"
        }
      }
    },
    {
      "name": "paired_cdd_agg",
      "_note": "paired_cdd plus aggregation consistency; the 2x2 completion of arms 3-5.",
      "overrides": {
        "trainer": {
          "save_dir": "${work}/outputs/save_CFF/ablation_paired_alignment_objectives/paired_cdd_agg",
          "wandb_name": "paired_cdd_agg"
        },
        "data": {},
        "model": { "monitor_losses": ["mmd"] },
        "features": {
          "unified": true,
          "paired_sampling": true,
          "cdd": true,
          "cdd_class_aware": true,
          "cdd_cluster_warmup_steps": 50,
          "agg_consistency": true,
          "agg_fn": "mean"
        }
      }
    }
  ],

  "downstream_tasks": [],

  "slurm": {
    "enabled": true,
    "python_executable": "python",
    "sbatch_args": [
      "--time=24:00:00",
      "--partition=gpu",
      "--ntasks-per-node=1",
      "--gres=gpu:rtx4090:1",
      "--cpus-per-task=4",
      "--mem-per-cpu=16G"
    ],
    "environment": {},
    "job_name_prefix": "ab_align"
  }
}

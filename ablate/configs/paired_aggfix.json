{
  "experiment_name": "paired_aggfix_ablation",
  "output_dir": "ablation_runs/paired_aggfix",
  "dry_run": false,
  "train_entrypoint": "pretrain:main",
  "base_config": {
    "trainer": {
      "gpus": 1,
      "num_workers": 4,
      "precision": "bf16-mixed",
      "strategy": "ddp",
      "epochs": 10,
      "seed": 0,
      "val_check_interval": 0.5,
      "log_interval": 50,
      "save_dir": "${work}/outputs/save_CFF/ablation_paired_aggfix",
      "wandb_entity": "rquiles",
      "wandb": "ablation_paired_aggfix",
      "compile": true,
      "ckpt_every_n_steps": 50000,
      "resume_from_checkpoint": "last"
    },
    "data": {
      "train_path": "/cluster/work/boeva/rquiles/data/paired_dataset/pipeline_ready",
      "conditions": ["tissue_general", "assay"],
      "zero_percentages": [0.2, 0.4, 0.6],
      "bulk_ratio": 0.45,
      "pb_ratio": 0.45,
      "n_sc_per_pseudobulk": 10,
      "pb_group_column": "tissue_general",
      "trunc_by_sample": true,
      "balanced_sampler": true,
      "balanced_labels": ["tissue_general", "assay"]
    },
    "model": {
      "nlayers": 6,
      "nheads": 8,
      "embsize": 128,
      "d_hid": 256,
      "lr": 0.0001,
      "warmup_ratio_or_step": 10000,
      "max_seq_len": 600,
      "batch_size": 32,
      "input_style": "binned",
      "loss": "mse",
      "training_tasks": "both",
      "do_mvc": true,
      "where_condition": "none",
      "gen_method": "theirs"
    },
    "features": {
      "unified": false
    }
  },
  "base_overrides": {},
  "ablations": [
      {
      "name": "",
      "overrides": {
        "trainer": {
          "save_dir": "${work}/outputs/save_CFF/",
          "wandb_name": ""
        },
        "data": {
          "train_path": ""
        },
        "model": {},
        "features": {
          "unified": true
        }
      }
    }
  ],
  "downstream_tasks": [],
  "slurm": {
    "enabled": true,
    "python_executable": "python",
    "sbatch_args": [
      "--time=48:00:00",
      "--partition=gpu",
      "--ntasks-per-node=1",
      "--gres=gpu:rtx4090:1",
      "--cpus-per-task=4",
      "--mem-per-cpu=16G"
    ],
    "environment": {},
    "job_name_prefix": "ab_paired"
  }
}
{
  "trainer": {
    "gpus": 0,
    "num_workers": 1,
    "precision": 32,
    "strategy": "auto",
    "epochs": 1,
    "seed": 0,
    "val_check_interval": 0.5,
    "log_interval": 1,
    "save_dir": "${work}/outputs/save_CFF/dummy_test",
    "ckpt_every_n_steps": 5
  },
  "data": {
    "train_path": "/cluster/work/boeva/rquiles/data/paired_dataset/pipeline_ready",
    "conditions": ["tissue_general", "assay"],
    "zero_percentages": [0.2, 0.4, 0.6],
    "bulk_ratio": 0.45,
    "pb_ratio": 0.45,
    "n_sc_per_pseudobulk": 5,
    "pb_group_column": "tissue_general",
    "trunc_by_sample": true,
    "balanced_sampler": true,
    "balanced_labels": ["tissue_general", "assay"],
    "paired_sampling": true,
    "paired_every_n": 5
  },

  "model": {
    "nlayers": 2,
    "nheads": 2,
    "embsize": 32,
    "d_hid": 32,
    "lr": 0.0001,
    "warmup_ratio_or_step": 10000,
    "max_seq_len": 600,
    "batch_size": 8,
    "input_style": "binned",
    "loss": "mse",
    "training_tasks": "both",
    "do_mvc": true,
    "where_condition": "none",
    "gen_method": "theirs"
  },
  
  "features": {
    "unified": true
  }
}

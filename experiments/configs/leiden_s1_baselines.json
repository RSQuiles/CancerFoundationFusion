{
  "launch_name": "leiden_s1_baselines",
  "_comment": [
    "Four baselines on the linked leiden_s1 stores (data_preprocess/scripts/rebuild_leiden_s1.sbatch):",
    "sc only, bulk only, sc + bulk, and sc + bulk + precomputed pseudobulk without alignment losses.",
    "Same architecture as bulk_pretrain / sc_pretrain, midrank binning, and a MATCHED step budget:",
    "every model runs epoch_size x epochs = 10000 x 40 = 400k optimizer steps (epoch_size also sets the",
    "epoch length of the single-modality runs). Tune both from the store sizes the sbatch prints.",
    "Checkpoints every 50k steps give the bulk-exposure curve for GeneICL.",
    "bulk_sc_pretrain reads the joint store with pb_ratio 0, so its pseudobulk rows are never drawn;",
    "unified_baseline only LOGS mmd / contrastive / cdd (monitor_losses), it does not train on them."
  ],
  "experiments_root": "/cluster/work/boeva/rquiles/unifiedFM_experiments",
  "dry_run": false,
  "train_entrypoint": "pretrain:main",
  "base_config": {
    "trainer": {
      "gpus": 1,
      "num_workers": 4,
      "precision": "bf16-mixed",
      "strategy": "auto",
      "epochs": 20,
      "seed": 0,
      "val_check_interval": 0.5,
      "log_interval": 50,
      "wandb_entity": "rquiles",
      "wandb": "unifiedFM",
      "compile": true,
      "ckpt_every_n_steps": 50000,
      "save_every": true,
      "resume_from_checkpoint": "last",
      "resume_mode": "exact"
    },
    "data": {
      "zero_percentages": [0.2, 0.4, 0.6],
      "epoch_size": 10000
    },
    "model": {
      "nlayers": 8,
      "nheads": 8,
      "embsize": 256,
      "d_hid": 1024,
      "lr": 0.0001,
      "warmup_ratio_or_step": 1000,
      "max_seq_len": 1200,
      "batch_size": 64,
      "input_style": "binned",
      "n_bins": 51,
      "binning_method": "midrank",
      "loss": "mse",
      "training_tasks": "both",
      "do_mvc": true,
      "where_condition": "none",
      "gen_method": "theirs"
    },
    "features": {}
  },
  "base_overrides": {},
  "models": [
    {
      "name": "sc_baseline",
      "overrides": {
        "data": {"train_path": {"pipeline_ready": "single_cell:leiden_s1"}}
      }
    },
    {
      "name": "bulk_baseline",
      "overrides": {
        "data": {"train_path": {"pipeline_ready": "bulk:leiden_s1"}}
      }
    },
    {
      "name": "bulk_sc_baseline",
      "overrides": {
        "data": {
          "train_path": {"mix": "sc_bulk_pb_leiden_s1"},
          "conditions": [],
          "bulk_ratio": 0.7,
          "pb_ratio": 0.0
        },
        "features": {"unified": true}
      }
    },
    {
      "name": "unified_baseline",
      "overrides": {
        "data": {
          "train_path": {"mix": "sc_bulk_pb_leiden_s1"},
          "conditions": ["tissue_general"],
          "condition_encoders": [],
          "bulk_ratio": 0.35,
          "pb_ratio": 0.35,
          "precomputed_pb": true,
          "pb_label": "pseudobulk",
          "pb_group_column": "tissue_general"
        },
        "features": {
          "unified": true,
          "monitor_losses": ["mmd", "contrastive", "cdd"],
          "class_exclude_labels": ["unknown", "paired", "cell line", "in vitro", "xenograft"]
        }
      }
    }
  ],
  "downstream_tasks": [],
  "slurm": {
    "enabled": true,
    "python_executable": "python",
    "sbatch_args": [
      "--time=72:00:00",
      "--partition=gpu",
      "--ntasks-per-node=1",
      "--gres=gpu:rtx4090:1",
      "--cpus-per-task=4",
      "--mem-per-cpu=16G"
    ],
    "environment": {},
    "job_name_prefix": "ufm",
    "project_root": "/cluster/work/boeva/rquiles/CancerFoundationFusion",
    "singularity_image": "/cluster/customapps/biomed/boeva/rquiles/bionemo-framework_v1.sif",
    "binds": [
      "/cluster/work/boeva/rquiles",
      "/cluster/work/boeva/eheiss",
      "/cluster/work/boeva/bulkFM"
    ]
  }
}

{
  "experiment_name": "paired_counts",
  "output_dir": "ablation_runs/paired_counts",
  "dry_run": false,
  "train_entrypoint": "pretrain:main",
  "base_config": {
    "trainer": {
      "gpus": 1,
      "num_workers": 4,
      "precision": "bf16-mixed",
      "strategy": "auto",
      "epochs": 5,
      "seed": 0,
      "val_check_interval": 0.5,
      "log_interval": 50,
      "save_dir": "${work}/outputs_rquiles/save_CFF/ablation_paired_counts",
      "wandb_entity": "rquiles",
      "wandb": "ablation_paired_counts",
      "compile": false,
      "ckpt_every_n_steps": 10000,
      "resume_from_checkpoint": "last"
    },
    "data": {
      "train_path": "/cluster/work/boeva/rquiles/data/paired_dataset_counts/pipeline_ready",
      "conditions": ["tissue_general", "assay", "paired"],
      "zero_percentages": [0.2, 0.4, 0.6],
      "bulk_ratio": 0.45,
      "pb_ratio": 0.45,
      "n_sc_per_pseudobulk": 10,
      "pb_group_column": "tissue_general",
      "trunc_by_sample": true,
      "balanced_sampler": true,
      "balanced_labels": ["tissue_general", "assay"]
    },
    "model": {
      "nlayers": 6,
      "nheads": 8,
      "embsize": 128,
      "d_hid": 256,
      "lr": 0.0001,
      "warmup_ratio_or_step": 10000,
      "max_seq_len": 600,
      "batch_size": 32,
      "input_style": "binned",
      "input_data": "counts",
      "loss": "mse",
      "training_tasks": "both",
      "do_mvc": true,
      "where_condition": "none",
      "gen_method": "theirs"
    },
    "features": {
      "loss_weight_paired": 100,
      "loss_weight_dat": 100,
      "loss_weight_agg": 10
    }
  },
  "base_overrides": {},
  "ablations": [
    {
      "name": "bulk_baseline",
      "overrides": {
        "trainer": {
          "save_dir": "${work}/outputs_rquiles/save_CFF/ablation_paired_counts/bulk_baseline",
          "wandb_name": "bulk_baseline"
        },
        "data": {
          "train_path": "/cluster/work/boeva/rquiles/data/bulk_counts/pipeline_ready",
          "conditions": ["tissue_general", "assay"]
        },
        "model": {},
        "features": {}
      }
    },
    {
      "name": "unified",
      "overrides": {
        "trainer": {
          "save_dir": "${work}/outputs_rquiles/save_CFF/ablation_paired_counts/unified",
          "wandb_name": "unified"
        },
        "data": {},
        "model": {},
        "features": {
          "unified": true,
	        "paired_sampling": true
        }
      }
    },
        {
      "name": "dat",
      "overrides": {
        "trainer": {
          "save_dir": "${work}/outputs_rquiles/save_CFF/ablation_paired_counts/dat",
          "wandb_name": "dat"
        },
        "data": {},
        "model": {},
        "features": {
          "unified": true,
	        "paired_sampling": true,
          "do_dat": true,
          "dat_columns": ["modality", "assay"]
        }
      }
    },
    {
      "name": "contrastive",
      "overrides": {
        "trainer": {
          "save_dir": "${work}/outputs_rquiles/save_CFF/ablation_paired_counts/contrastive",
          "wandb_name": "contrastive"
        },
        "data": {},
        "model": {},
        "features": {
          "unified": true,
	        "paired_sampling": true,
          "contrastive_training": true
        }
      }
    },
    {
      "name": "aggregation",
      "overrides": {
        "trainer": {
          "save_dir": "${work}/outputs_rquiles/save_CFF/ablation_paired_counts/aggregation",
          "wandb_name": "aggregation"
        },
        "data": {},
        "model": {},
        "features": {
          "unified": true,
	        "paired_sampling": true,
          "agg_consistency": true
        }
      }
    }
  ],
  "downstream_tasks": [],
  "slurm": {
    "enabled": true,
    "python_executable": "python",
    "sbatch_args": [
      "--time=72:00:00",
      "--partition=gpu",
      "--ntasks-per-node=1",
      "--gres=gpu:rtx4090:1",
      "--cpus-per-task=4",
      "--mem-per-cpu=16G"
    ],
    "environment": {},
    "job_name_prefix": "ab_paired"
  }
}
{
  "launch_name": "unifiedfm_example",
  "experiments_root": "/cluster/work/boeva/rquiles/unifiedFM_experiments",
  "dry_run": false,
  "train_entrypoint": "pretrain:main",
  "base_config": {
    "trainer": {
      "gpus": 1,
      "num_workers": 4,
      "precision": "bf16-mixed",
      "strategy": "auto",
      "epochs": 5,
      "seed": 0,
      "val_check_interval": 0.5,
      "log_interval": 50,
      "wandb_entity": "rquiles",
      "wandb": "unifiedFM",
      "compile": true,
      "ckpt_every_n_steps": 10000
    },
    "data": {
      "train_path": {"mix": "sc_bulk_pb_tissue_s0"},
      "conditions": ["tissue_general", "assay", "paired"],
      "zero_percentages": [0.2, 0.4, 0.6],
      "bulk_ratio": 0.45,
      "pb_ratio": 0.45,
      "n_sc_per_pseudobulk": 10,
      "pb_group_column": "tissue_general",
      "trunc_by_sample": true,
      "balanced_sampler": true,
      "balanced_labels": ["tissue_general", "assay"]
    },
    "model": {
      "nlayers": 6,
      "nheads": 8,
      "embsize": 128,
      "d_hid": 256,
      "lr": 0.0001,
      "warmup_ratio_or_step": 10000,
      "max_seq_len": 600,
      "batch_size": 32,
      "input_style": "binned",
      "loss": "mse",
      "training_tasks": "both",
      "do_mvc": true,
      "where_condition": "none",
      "gen_method": "theirs"
    },
    "features": {
      "loss_weight_paired": 100,
      "loss_weight_dat": 100,
      "loss_weight_agg": 100
    }
  },
  "base_overrides": {},
  "models": [
    {
      "name": "bulk_only_tissue_s0",
      "overrides": {
        "data": {
          "train_path": {"pipeline_ready": "bulk:tissue_s0"}
        }
      }
    },
    {
      "name": "unified_paired_tissue_s0",
      "overrides": {
        "features": {
          "unified": true,
          "paired_sampling": true
        }
      }
    },
    {
      "name": "unified_paired_dat_tissue_s0",
      "overrides": {
        "features": {
          "unified": true,
          "paired_sampling": true,
          "do_dat": true,
          "dat_columns": ["modality", "assay"]
        }
      }
    },
    {
      "name": "unified_paired_contrastive_tissue_s0",
      "overrides": {
        "features": {
          "unified": true,
          "paired_sampling": true,
          "contrastive_training": true
        }
      }
    }
  ],
  "downstream_tasks": [],
  "slurm": {
    "enabled": true,
    "python_executable": "python",
    "sbatch_args": [
      "--time=72:00:00",
      "--partition=gpu",
      "--ntasks-per-node=1",
      "--gres=gpu:rtx4090:1",
      "--cpus-per-task=4",
      "--mem-per-cpu=16G"
    ],
    "environment": {},
    "job_name_prefix": "ufm",
    "project_root": "/cluster/work/boeva/rquiles/CancerFoundationFusion",
    "singularity_image": "/cluster/customapps/biomed/boeva/rquiles/bionemo-framework_v1.sif",
    "binds": [
      "/cluster/work/boeva/rquiles",
      "/cluster/work/boeva/eheiss",
      "/cluster/work/boeva/bulkFM"
    ]
  }
}
